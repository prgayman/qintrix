{
  "name": "qintrix-web-sdk",
  "version": "1.0.0",
  "description": "Browser-first TypeScript SDK for the Qintrix print agent API.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.mjs"
  },
  "keywords": [
    "qintrix",
    "sdk",
    "print",
    "typescript",
    "web"
  ],
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
